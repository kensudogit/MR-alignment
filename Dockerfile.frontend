# フロントエンド用の本番Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

# バックエンドのオリジン（末尾に /api は付けない）。
#
# Vite は VITE_ プレフィックスの変数を「ビルド時に」成果物へ埋め込むため、
# 実行時の環境変数では差し替えられない。必ずビルド引数として渡すこと。
# Railway は Variables に設定した値を同名の ARG へ自動で渡す。
ARG VITE_API_URL
ARG VITE_ENVIRONMENT=production

# 未設定のままビルドすると frontend/src/services/api.ts の既定値
# http://localhost:8000 が焼き込まれ、訪問者のブラウザが
# 自分自身のPCへ接続しにいく壊れた成果物ができる。
# 画面は表示されるためデプロイは成功したように見え、
# API呼び出しだけが黙って失敗する。実際にこの状態で公開されていたため、
# ビルドを通さずここで止める。
RUN if [ -z "$VITE_API_URL" ]; then \
      echo "" >&2; \
      echo "ERROR: ビルド引数 VITE_API_URL が未設定です。" >&2; \
      echo "  Railway  : Variables に VITE_API_URL を追加してください" >&2; \
      echo "             例) https://<バックエンドのサービス>.up.railway.app" >&2; \
      echo "  ローカル : docker build --build-arg VITE_API_URL=http://localhost:8000 ..." >&2; \
      echo "" >&2; \
      exit 1; \
    fi

# パッケージファイルをコピー
COPY frontend/package*.json ./

# 依存関係をインストール
RUN npm ci

# ソースコードをコピー
COPY frontend/ .

# ビルドを実行（ここで VITE_ 変数が成果物へ埋め込まれる）
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT
RUN npm run build

# 本番ステージ: Nginxで静的ファイルを配信
FROM nginx:alpine

# ビルド成果物をコピー
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx設定ファイルをテンプレートとしてコピー
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template

# 起動スクリプトをコピーして実行権限を付与
COPY frontend/docker-start.sh /docker-start.sh
RUN chmod +x /docker-start.sh

# RailwayのPORT環境変数に対応（デフォルトは80）
ENV PORT=80

# ポートを公開
EXPOSE $PORT

# Nginxを起動（起動スクリプトでenvsubst→nginx）
CMD ["/docker-start.sh"]
