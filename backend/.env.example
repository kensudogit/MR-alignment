# =========================================================================
# MR-alignment バックエンド（FastAPI）環境変数
#
# 【重要】このファイルはテンプレートです。実際の値を書いた .env は
#         .gitignore により追跡されません。絶対にコミットしないでください。
# =========================================================================

# ------------------------------------------------------------- アプリ
APP_NAME="MR Alignment API"
APP_ENV=local                 # local / test / staging / production
APP_DEBUG=true                # 本番では必ず false（起動時に検証されます）
API_PREFIX=/api
LOG_LEVEL=INFO

# ------------------------------------------------------------- データベース
# PostgreSQL への永続化。非同期ドライバ(asyncpg)を使用します。
# docker-compose 利用時はホスト名を postgres にしてください。
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mr_alignment
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------- 認証（JWT）
# 【必須・本番】未設定だと起動ごとにランダム生成され、
# 再起動のたびに全ユーザーがログアウトします。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------- CORS
# 許可オリジン。カンマ区切りで複数指定できます。
# '*' は使わないでください（全オリジンからのAPI利用を許してしまいます）。
FRONTEND_URL=http://localhost:3000

# Vercel のプレビューデプロイなど動的ドメインを許可する場合のみ設定
# CORS_ALLOW_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ------------------------------------------------------------- OpenAI
# 【重要】このキーはサーバー側でのみ保持します。
# フロントエンドの VITE_OPENAI_API_KEY に置いてはいけません
# （VITE_ プレフィックスの変数はビルド成果物に埋め込まれ、ブラウザから読めます）。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# ------------------------------------------------------------- メール
# 未設定の場合、お問い合わせ通知は送信されません（内容はDBに保存されます）。
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="MR Alignment"
CONTACT_MAIL_TO=

# ------------------------------------------------------------- レート制限
# 形式: <回数>/<second|minute|hour|day>
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CONTACT=10/hour
RATE_LIMIT_OPENAI=10/minute
