# =========================================================================
# MR-alignment バックエンド（FastAPI）環境変数
#
# 【重要】このファイルはテンプレートです。実際の値を書いた .env は
#         .gitignore により追跡されません。絶対にコミットしないでください。
# =========================================================================

# ------------------------------------------------------------- アプリ
APP_NAME="MR Alignment API"
APP_ENV=local                 # local / test / staging / production
APP_DEBUG=true                # 本番では必ず false（起動時に検証されます）
API_PREFIX=/api
LOG_LEVEL=INFO

# ------------------------------------------------------------- データベース
# PostgreSQL への永続化。非同期ドライバ(asyncpg)を使用します。
# docker-compose 利用時はホスト名を postgres にしてください。
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mr_alignment
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------- 認証（JWT）
# 【必須・本番】未設定だと起動ごとにランダム生成され、
# 再起動のたびに全ユーザーがログアウトします。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------- CORS
# 許可オリジン。カンマ区切りで複数指定できます。
# '*' は使わないでください（全オリジンからのAPI利用を許してしまいます）。
FRONTEND_URL=http://localhost:3000

# Vercel のプレビューデプロイなど動的ドメインを許可する場合のみ設定
# CORS_ALLOW_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ------------------------------------------------------------- OpenAI
# 【重要】このキーはサーバー側でのみ保持します。
# フロントエンドの VITE_OPENAI_API_KEY に置いてはいけません
# （VITE_ プレフィックスの変数はビルド成果物に埋め込まれ、ブラウザから読めます）。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# ------------------------------------------------------------- メール
# 未設定の場合、お問い合わせ通知は送信されません（内容はDBに保存されます）。
# また、資料ダウンロードフォームからのAI資料メールも送信されません
# （資料自体は画面には表示されます）。
#
# 接続方式は2種類。ポート番号と合っていないと、静かに送信されないだけになります。
#   MAIL_USE_SSL=true … ポート 465。接続の最初から TLS（SMTPS）。ISP のサーバーはこちら
#   MAIL_USE_TLS=true … ポート 587。平文で接続してから TLS へ切り替える（STARTTLS）
# ポートが 465 なら MAIL_USE_SSL 未設定でも SMTPS として扱います（app/config.py）。
#
# 【本番の設定例（JCOM / ZAQ）】※現在の構成
#   MAIL_HOST=mailssl.zaq.ne.jp
#   MAIL_PORT=465
#   MAIL_USE_SSL=true
#   MAIL_USERNAME=<JCOMのメールアドレス>
#   MAIL_PASSWORD=<JCOMのメールパスワード>
#   MAIL_FROM_ADDRESS=<MAIL_USERNAME と同じアドレス>  ← 違うと差出人詐称として拒否される
#
# 【本番の設定例（SendGrid）】
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=<SendGrid の APIキー>
#   MAIL_FROM_ADDRESS=noreply@<送信ドメイン>   ← SPF/DKIM を設定済みのドメインにすること
#
# 開発時は docker-compose の mailpit へ送り、http://localhost:8025 で確認します。
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_SSL=false
MAIL_USE_TLS=false
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="MR Alignment"
CONTACT_MAIL_TO=

# ------------------------------------------------------------- 管理者
# 面談予約の管理画面（/admin/appointments）と管理APIを使えるアカウント。
# カンマ区切りで複数指定できます。ここに載っていないアカウントは、
# ログイン済みでも 403 になります（未設定なら誰も開けません）。
# 例: ADMIN_EMAILS=kensudo@jcom.zaq.ne.jp
ADMIN_EMAILS=

# ------------------------------------------------------------- 本番運用
# ログを1行1JSONで出す。未指定なら APP_ENV=production のときだけ有効。
# CloudWatch Logs Insights で絞り込むために必要です。
LOG_JSON=

# 自分の前段にいる信頼できるプロキシの段数。
# X-Forwarded-For の「右から何個目」を本当のクライアントとみなすかに使います。
# 先頭は詐称できるため、絶対に先頭を採ってはいけません（app/dependencies.py）。
#   0 → ヘッダを一切信用しない（既定）
#   1 → ALB や一般的なリバースプロキシが1段
#   2 → CloudFront → ALB の2段
#
# 既定が 0 なのは、間違える向きを選んでいるためです。
#   足りない側に間違える → ヘッダを付け替えるだけでレート制限を回避できる（危険）
#   多い側に間違える     → 全員が同じ IP に見え、制限を共有する（不便だが破られない）
#
# 【重要】0 のままだと、レート制限が IP 単位ではなく全体で1枠になります。
# 実際の段数はデプロイ後にアクセスログの client_ip で確認して設定してください
# （docs/railway-setup.md の「2-0」）。
TRUSTED_PROXY_HOPS=0

# レート制限の共有ストア。未設定だとプロセス内メモリになり、
# タスクやワーカーを増やすと実効上限がその数だけ緩みます。
# 例: rediss://xxx.cache.amazonaws.com:6379/0
REDIS_URL=

# Amazon SES の設定セット名（バウンス・苦情の集計に使う）。SES 以外では空。
MAIL_CONFIGURATION_SET=

# false にすると起動時のマイグレーションを実行しません。
# デプロイ時に専用タスクで流す運用にする場合に使います。
RUN_MIGRATIONS=true

# ------------------------------------------------------------- レート制限
# 形式: <回数>/<second|minute|hour|day>
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CONTACT=10/hour
# 面談予約は枠を押さえる操作なので、問い合わせより厳しくします。
RATE_LIMIT_APPOINTMENT=5/hour
RATE_LIMIT_OPENAI=10/minute
# 資料請求は未認証で呼べるため厳しめに設定します（IPアドレス単位）。
RATE_LIMIT_DOCUMENT=5/hour
